# Copy to .env and fill in. Every setting has a sensible default for the simulated demo.

# --- mode -----------------------------------------------------------------------------------
TRACKMYFERRY_MODE=sim                 # sim | live
TRACKMYFERRY_BUS=memory               # memory (one process) | kafka (docker compose)
SIM_SPEEDUP=1                      # sim mode: 10 = ten simulated seconds per real second

# --- live data sources ---------------------------------------------------------------------
AISSTREAM_API_KEY=                 # free key from https://aisstream.io (sign in with GitHub)
# GTFS_STATIC_URL=http://nycferry.connexionz.net/rtt/public/resource/gtfs.zip
# GTFS_RT_TRIP_UPDATES_URL=https://nycferry.connexionz.net/rtt/public/utility/gtfsrealtime.aspx/tripupdate
# GTFS_RT_ALERTS_URL=https://nycferry.connexionz.net/rtt/public/utility/gtfsrealtime.aspx/alert
# GTFS_STATIC_PATH=data/live/nycferry_gtfs.zip   # use a local copy instead of the URL
# TRACKMYFERRY_BBOX=40.54,-74.12,40.83,-73.78       # south,west,north,east
# NOAA_CURRENT_STATION=NYH1924                   # Hell Gate, East River
# SOCRATA_APP_TOKEN=                             # optional, raises NYC Open Data rate limits

# --- infrastructure (optional in single-process mode) -----------------------------------------
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# DATABASE_URL=postgresql://trackmyferry:trackmyferry@localhost:5432/trackmyferry
# REDIS_URL=redis://localhost:6379/0

# --- paths & tuning ----------------------------------------------------------------------------
# TRACKMYFERRY_DATA_DIR=data
# TRACKMYFERRY_MODEL_DIR=models
# TRACKMYFERRY_WEB_DIST=web/dist
# VESSEL_CAPACITY=150
# PREDICTION_INTERVAL_S=15
# API_PORT=8000
